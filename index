<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Передача файлов WebRTC</title>
<style>
  body { font-family: monospace; padding: 20px; max-width: 600px; }
  input, button { font-size: 16px; margin: 4px 0; padding: 6px; }
  button { cursor: pointer; }
  #log { border: 1px solid #000; height: 200px; overflow-y: auto; padding: 6px; margin-top: 10px; white-space: pre-wrap; }
  .row { margin: 8px 0; }
  #progress { margin-top: 8px; }
</style>
</head>
<body>

<h3>Передача файлов (WebRTC)</h3>

<div class="row">
  <button onclick="createConnection()">1. Создать соединение (получатель)</button>
</div>

<div class="row">
  Ваш ID: <input id="myId" readonly size="40">
</div>

<div class="row">
  ID получателя: <input id="remoteId" placeholder="вставьте ID">
  <button onclick="connectToRemote()">2. Подключиться (отправитель)</button>
</div>

<div class="row">
  Статус: <span id="status">не подключено</span>
</div>

<div class="row">
  <input type="file" id="fileInput" multiple>
  <button onclick="sendFiles()">3. Отправить файлы</button>
</div>

<div id="progress"></div>

<div id="log"></div>

<script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
<script>
let peer = null;
let conn = null;
let incoming = {}; // буфер для входящих файлов
let totalBytes = 0, receivedBytes = 0;

const logEl = document.getElementById('log');
const statusEl = document.getElementById('status');
const progressEl = document.getElementById('progress');

function log(msg) {
  logEl.textContent += msg + '\n';
  logEl.scrollTop = logEl.scrollHeight;
}

function setStatus(s) {
  statusEl.textContent = s;
}

// 1. Создаём Peer (получатель). ID генерируется автоматически.
function createConnection() {
  if (peer) { log('Peer уже создан'); return; }

  peer = new Peer();

  peer.on('open', (id) => {
    document.getElementById('myId').value = id;
    log('Мой ID: ' + id);
    setStatus('ожидание подключения');
  });

  peer.on('connection', (c) => {
    conn = c;
    setupConnection();
  });

  peer.on('error', (err) => log('Ошибка Peer: ' + err));
}

// 2. Отправитель подключается по ID получателя
function connectToRemote() {
  const remoteId = document.getElementById('remoteId').value.trim();
  if (!remoteId) { log('Введите ID получателя'); return; }

  if (!peer) {
    peer = new Peer();
    peer.on('open', () => {
      log('Peer создан, подключаюсь...');
      doConnect(remoteId);
    });
    peer.on('error', (err) => log('Ошибка Peer: ' + err));
  } else {
    doConnect(remoteId);
  }
}

function doConnect(remoteId) {
  conn = peer.connect(remoteId);
  setupConnection();
}

function setupConnection() {
  conn.on('open', () => {
    log('Соединение установлено');
    setStatus('подключено');
  });

  conn.on('data', handleData);

  conn.on('close', () => {
    log('Соединение закрыто');
    setStatus('закрыто');
  });

  conn.on('error', (err) => log('Ошибка соединения: ' + err));
}

// 3. Отправка файлов
async function sendFiles() {
  if (!conn || !conn.open) { log('Нет соединения'); return; }

  const files = document.getElementById('fileInput').files;
  if (!files.length) { log('Выберите файлы'); return; }

  for (const file of files) {
    log(`Отправка: ${file.name} (${file.size} байт)`);

    // Метаданные
    conn.send({ type: 'meta', name: file.name, size: file.size });

    // Читаем и шлём чанками
    const chunkSize = 16 * 1024; // 16 КБ
    let offset = 0;

    while (offset < file.size) {
      const slice = file.slice(offset, offset + chunkSize);
      const buf = await slice.arrayBuffer();
      conn.send({ type: 'chunk', data: buf });
      offset += chunkSize;

      const percent = Math.round((offset / file.size) * 100);
      progressEl.textContent = `${file.name}: ${percent}%`;
    }

    conn.send({ type: 'end' });
    log(`Отправлено: ${file.name}`);
  }

  progressEl.textContent = 'Готово';
}

// Приём данных
function handleData(msg) {
  if (msg.type === 'meta') {
    incoming = { name: msg.name, size: msg.size, chunks: [], received: 0 };
    totalBytes = msg.size;
    receivedBytes = 0;
    log(`Входящий файл: ${msg.name} (${msg.size} байт)`);
  }

  else if (msg.type === 'chunk') {
    incoming.chunks.push(msg.data);
    incoming.received += msg.data.byteLength;
    receivedBytes += msg.data.byteLength;

    const percent = Math.round((incoming.received / incoming.size) * 100);
    progressEl.textContent = `${incoming.name}: ${percent}%`;
  }

  else if (msg.type === 'end') {
    const blob = new Blob(incoming.chunks);
    const url = URL.createObjectURL(blob);

    const a = document.createElement('a');
    a.href = url;
    a.download = incoming.name;
    a.textContent = `Скачать ${incoming.name}`;
    a.style.display = 'block';

    progressEl.appendChild(document.createElement('br'));
    progressEl.appendChild(a);

    log(`Получен файл: ${incoming.name}`);
    incoming = {};
  }
}
</script>

</body>
</html>
